"use strict";

// توحيد النص العربي لتسهيل البحث
function normalizeText(text) {
  return String(text || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u064B-\u065F\u0670]/g, "")
    .replace(/[أإآ]/g, "ا")
    .replace(/ى/g, "ي")
    .replace(/ة/g, "ه")
    .replace(/\s+/g, " ")
    .trim();
}

// عناصر الصفحة
const searchInput = document.getElementById("searchInput");
const categoryCards = document.querySelectorAll(".category-card");
const noResults = document.getElementById("noResults");

// إنشاء لوحة تفاصيل القسم
function createPanel(card) {
  let panel = card.nextElementSibling;

  if (panel && panel.classList.contains("category-details")) {
    return panel;
  }

  panel = document.createElement("div");
  panel.className = "category-details";
  panel.hidden = true;
  panel.setAttribute("role", "region");

  const title = card.querySelector("strong")?.textContent || "القسم";

  panel.innerHTML = `
    <h3></h3>
    <p>نعمل على تجهيز المنتجات والأسعار الموثوقة لهذا القسم.</p>
    <p>سيتم إضافة الأسعار مع توضيح المصدر وتاريخ التحديث.</p>
  `;

  panel.querySelector("h3").textContent = title;
  card.insertAdjacentElement("afterend", panel);

  return panel;
}

// فتح وإغلاق الأقسام
categoryCards.forEach(function (card) {
  const panel = createPanel(card);

  card.setAttribute("aria-expanded", "false");

  card.addEventListener("click", function (event) {
    event.preventDefault();

    const isOpen = !panel.hidden;

    categoryCards.forEach(function (otherCard) {
      const otherPanel = otherCard.nextElementSibling;

      if (
        otherPanel &&
        otherPanel.classList.contains("category-details")
      ) {
        otherPanel.hidden = true;
        otherCard.setAttribute("aria-expanded", "false");
      }
    });

    if (!isOpen) {
      panel.hidden = false;
      card.setAttribute("aria-expanded", "true");
    }
  });
});

// البحث داخل الأقسام
if (searchInput) {
  searchInput.addEventListener("input", function () {
    const term = normalizeText(this.value);
    let visibleCount = 0;

    categoryCards.forEach(function (card) {
      const text = normalizeText(
        card.textContent + " " + (card.dataset.search || "")
      );

      const matches = text.includes(term);

      card.hidden = !matches;

      const panel = card.nextElementSibling;

      if (panel && panel.classList.contains("category-details")) {
        panel.hidden = true;
        card.setAttribute("aria-expanded", "false");
      }

      if (matches) visibleCount++;
    });

    if (noResults) {
      noResults.hidden = visibleCount !== 0;
    }
  });
}

// تثبيت الموقع كتطبيق
let deferredPrompt;

const installBtn = document.getElementById("installBtn");

window.addEventListener("beforeinstallprompt", function (event) {
  event.preventDefault();
  deferredPrompt = event;

  if (installBtn) {
    installBtn.hidden = false;
  }
});

if (installBtn) {
  installBtn.addEventListener("click", async function () {
    if (!deferredPrompt) return;

    deferredPrompt.prompt();
    await deferredPrompt.userChoice;

    deferredPrompt = null;
    installBtn.hidden = true;
  });
}

// تشغيل الموقع دون اتصال عند توفر الخدمة
if ("serviceWorker" in navigator && location.protocol === "https:") {
  window.addEventListener("load", function () {
    navigator.serviceWorker
      .register("./sw.js")
      .catch(function (error) {
        console.error("Service Worker Error:", error);
      });
  });
}